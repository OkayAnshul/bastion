# Copy to .env and adjust. Never commit .env.

# Paths (relative to the repository root)
BASTION_DATA_DIR=data
BASTION_ARTIFACTS_DIR=artifacts
BASTION_RESULTS_DIR=docs/results
BASTION_CONFIG_DIR=configs

# Services (host-side ports from docker-compose.yml)
BASTION_REDIS_URL=redis://localhost:6379/0
BASTION_KAFKA_BOOTSTRAP=localhost:19092
# MLflow: unset = local sqlite in mlruns/; uncomment to use the server started by `make up`.
# BASTION_MLFLOW_TRACKING_URI=http://localhost:5000

# Scoring service (`bastion serve`)
# A local model bundle directory; unset = load the MLflow registry alias below.
# BASTION_MODEL_PATH=artifacts/models/<run id>
BASTION_MODEL_NAME=bastion-fraud
BASTION_MODEL_ALIAS=champion
BASTION_DECISION_SINK=jsonl
BASTION_DECISION_LOG_PATH=artifacts/decisions/decisions.jsonl
# Redis connections per worker; requests beyond this while all are busy get a 503.
BASTION_REDIS_MAX_CONNECTIONS=100

# Logging
BASTION_LOG_LEVEL=INFO
BASTION_LOG_JSON=false

# Kaggle credentials: an alternative to ~/.kaggle/kaggle.json.
# You must first accept the ieee-fraud-detection competition rules on kaggle.com.
KAGGLE_USERNAME=
KAGGLE_KEY=
