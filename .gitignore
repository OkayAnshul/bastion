# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.ipynb_checkpoints/
node_modules/

# --- Secrets ---
.env
.env.*
!.env.example
kaggle.json

# Directory patterns are anchored with a leading "/": an unanchored `data/` also matched the
# src/bastion/data package and silently dropped it from a commit (docs/learning/mistakes.md).

# --- Data (IEEE-CIS competition rules forbid redistribution) ---
/data/

# --- Generated artifacts ---
/artifacts/
/mlruns/
/mlartifacts/
/profiles/
*.db
*.sqlite
*.sqlite3
*.parquet
!tests/fixtures/**/*.parquet
# Per-request benchmark samples (tens of MB); reports and summaries stay tracked.
docs/results/**/raw/

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
*.swp
